[Version]
Signature   = "$Windows NT$"
Class       = "ActivityMonitor"
ClassGuid   = {b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider    = %Provider%
; DriverVer is a placeholder: the build date and the Cargo workspace version
; are stamped by tools/Build-Driver.ps1.
DriverVer   = 01/01/2026,0.0.0.0
CatalogFile = fswfilter.cat
PnpLockdown = 1

[DestinationDirs]
FswFilter.DriverFiles = 13

[DefaultInstall.NT$ARCH$]
OptionDesc = %ServiceDescription%
CopyFiles  = FswFilter.DriverFiles

[DefaultInstall.NT$ARCH$.Services]
AddService = %ServiceName%,,FswFilter.Service

[FswFilter.Service]
DisplayName   = %ServiceName%
Description   = %ServiceDescription%
ServiceBinary = %13%\fswfilter.sys
Dependencies  = FltMgr
ServiceType   = 2
StartType     = 3
ErrorControl  = 1
LoadOrderGroup = "FSFilter Activity Monitor"
AddReg        = FswFilter.Registry

[FswFilter.Registry]
HKR,"Parameters","SupportedFeatures",0x00010001,0x3
HKR,"Parameters\Instances","DefaultInstance",0x00000000,"FswFilter Instance"
; lab placeholder - a production altitude must be allocated by Microsoft before any public release
HKR,"Parameters\Instances\FswFilter Instance","Altitude",0x00000000,"371120"
HKR,"Parameters\Instances\FswFilter Instance","Flags",0x00010001,0x0

[FswFilter.DriverFiles]
fswfilter.sys

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
fswfilter.sys = 1

[Strings]
Provider           = "Fara Technologies LLC"
ServiceName        = "FswFilter"
ServiceDescription = "Forward Slash Windows WSL path reparse filter (lab build)"
DiskName           = "Forward Slash Windows driver media"
