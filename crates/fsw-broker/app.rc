#include <winver.h>

// Kept in step with include/fsw_resources.h and the IDI_FSW_APP const in main.rs.
#define IDI_FSW_APP 101

// A reduced icon: the tray and the window class never request above 48px, and the
// resident broker is the binary where size matters most. See docs/size-baseline.md.
IDI_FSW_APP ICON "../../assets/fwdslash-tray.ico"

// VERSIONINFO fields come from the build script, which derives them from
// CARGO_PKG_VERSION (the workspace `version` in the root Cargo.toml). The
// fallbacks below keep this file compilable on its own -- and keep a build
// whose defines never arrived at the last known-good version rather than at
// 0.0.0 -- so they must be kept in step with Cargo.toml.
#ifndef FSW_VER_COMMAS
#define FSW_VER_COMMAS 0,0,4,0
#endif
#ifndef FSW_VER_STR
#define FSW_VER_STR "0.0.4"
#endif

1 VERSIONINFO
 FILEVERSION FSW_VER_COMMAS
 PRODUCTVERSION FSW_VER_COMMAS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Fara Technologies LLC\0"
            VALUE "FileDescription", "Forward Slash Windows Broker\0"
            VALUE "FileVersion", FSW_VER_STR
            VALUE "InternalName", "Forward Slash Windows Broker\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Mike Fara, Fara Technologies LLC\0"
            VALUE "OriginalFilename", "fswbroker.exe\0"
            VALUE "ProductName", "Forward Slash Windows\0"
            VALUE "ProductVersion", FSW_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
