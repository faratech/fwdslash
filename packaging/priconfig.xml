<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Indexes packaging\Assets so the scale-* and targetsize-* qualifiers in the
  filenames resolve to the unqualified names the manifest references
  (Assets\Square150x150Logo.png and so on). That is the whole job for the
  shipping (Rust) payload: it carries no PRI of its own and no App.xbf, because
  the Rust settings app builds its UI in code and embeds its one bitmap with
  include_bytes! rather than resolving ms-appx:/// URIs. The index still has to
  exist and still has to be named after Identity/Name, or the manifest's own
  logo qualifiers do not resolve.
-->
<resources targetOsVersion="10.0.0" majorVersion="1">
  <index root="\" startIndexAt="\">
    <default>
      <qualifier name="Language" value="en-US" />
      <qualifier name="Contrast" value="standard" />
      <qualifier name="Scale" value="200" />
      <qualifier name="HomeRegion" value="001" />
      <qualifier name="TargetSize" value="256" />
      <qualifier name="LayoutDirection" value="LTR" />
      <qualifier name="Theme" value="dark" />
      <qualifier name="AlternateForm" value="" />
      <qualifier name="DXFeatureLevel" value="DX9" />
      <qualifier name="Configuration" value="" />
      <qualifier name="DeviceFamily" value="Universal" />
      <qualifier name="Custom" value="" />
    </default>
    <!--
      Folder indexing only, with no "resfiles"/"priinfo" indexer. The Rust
      payload has nothing else to index; the C++ payload
      (Package-Msix.ps1 -BinarySource Cpp) additionally stages an MSBuild-built
      fswsettings.pri, and parsing that here as well would make both indexers
      claim Files/App.xbf, which makepri rejects with PRI277 "conflicting
      values".
    -->
    <indexer-config type="folder" foldernameAsQualifier="true" filenameAsQualifier="true" qualifierDelimiter="." />
  </index>
</resources>
