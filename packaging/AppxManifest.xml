<?xml version="1.0" encoding="utf-8"?>
<!--
  Template. tools/Package-Msix.ps1 substitutes the doubled-brace tokens below,
  once per architecture.

  This manifest replaces three things the unpackaged build does at runtime from
  fwdslash.exe: the HKCU Run value (windows.startupTask), the HKCU
  Software\Classes\fwdslash protocol registration (windows.protocol), and having
  the controller on PATH (windows.appExecutionAlias).

  There is one Application even though the package carries three executables:
  both the startupTask and appExecutionAlias extensions take their own
  Executable attribute, so the broker and the CLI do not need Store-visible app
  identities of their own.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop desktop4 rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="{{ARCHITECTURE}}" />

  <Properties>
    <DisplayName>fwdslash</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Type Linux-style WSL paths in File Explorer, Run, Windows Search and Open dialogs.</Description>

    <!--
      No virtualization exclusions and no unvirtualizedResources capability:
      the adapters are now installed by `fwdslash` itself, whose shell-facing
      registry state (Command Processor AutoRun, the ForwardSlashWindows
      settings) is written through reg.exe — a System32 child without package
      identity, so its writes land in the real hive despite MSIX
      virtualization. File payloads under %LOCALAPPDATA%\ForwardSlashWindows
      are written the same way; Documents is not virtualized. Reads use the
      merged view and are always correct. Verified 2026-09-04 (see
      docs/compatibility.md); drop-in exclusions are the fallback if a future
      Windows build ever redirects these writes.
    -->
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26200.0" />
    <!-- Broad Windows App Runtime 2.x compatibility -->
    <PackageDependency
      Name="Microsoft.WindowsAppRuntime.2"
      MinVersion="2.0.0.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
</Capabilities>

  <Applications>
    <!-- SupportsMultipleInstances is required by the console-subsystem execution
         alias below. fswsettings.exe is single-instance by its own mutex (a second
         activation raises the existing window and exits). -->
    <Application Id="App" Executable="fswsettings.exe" EntryPoint="Windows.FullTrustApplication"
                 desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="fwdslash"
        Description="Type Linux-style WSL paths in native Windows navigation surfaces."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Replaces the HKCU\Software\Classes\fwdslash registration. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="fwdslash">
            <uap:DisplayName>Forward Slash Windows settings</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
          </uap:Protocol>
        </uap:Extension>

        <!--
          Replaces the HKCU Run value. Enabled at install so a Store user reaches
          the same end state as an unpackaged user who runs "fwdslash install";
          Windows still lets them turn it off under Startup apps.
        -->
        <desktop:Extension Category="windows.startupTask" Executable="fswbroker.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
            TaskId="ForwardSlashWindowsBroker"
            Enabled="true"
            DisplayName="Forward Slash Windows" />
        </desktop:Extension>

        <!-- Puts the controller on PATH via %LOCALAPPDATA%\Microsoft\WindowsApps. -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="fwdslash.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="fwdslash.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
